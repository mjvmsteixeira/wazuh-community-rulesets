<!--
  Categoria: Credential Access
  Táticas MITRE ATT&CK cobertas: Brute Force (T1110), Privilege Escalation via Sudo (T1548.003)
-->
<group name="local,credential_access,">

  <rule id="100203" level="10">
    <if_sid>5402</if_sid>
    <field name="command" type="pcre2">(?i)COMMAND=(?:/usr/bin/|/bin/)?(?:bash|sh|zsh|ksh|tcsh|dash|su)\s*$|COMMAND=.*(?:sudoedit|sudo)\s+(?:-i|-s)\s*$</field>
    <description>ALERTA: Shell Interativo ou Acesso Root detectado (sudo su/bash/-i)</description>
    <mitre>
      <id>T1548.003</id>
      <id>T1059.004</id>
    </mitre>
    <group>pci_dss_10.2.2,pci_dss_10.2.5,gpg13_7.10,gdpr_IV_32.2,</group>
    <info type="text">Usuário obteve um shell interativo como root. Isso contorna o log de comandos individuais do sudo.</info>
  </rule>

  <rule id="100204" level="12" frequency="3" timeframe="120">
    <if_matched_sid>100203</if_matched_sid>
    <same_user />
    <description>ALERTA: Múltiplos shells interativos abertos pelo mesmo usuário em curto período</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <group>pci_dss_10.2.2,pci_dss_11.4,</group>
  </rule>

  <rule id="100205" level="11" frequency="4" timeframe="120">
    <if_matched_sid>5401</if_matched_sid>
    <same_user />
    <description>ALERTA: Multiple failed SUDO attempts by user $(user)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>sudo_abuse,pci_dss_10.2.2,</group>
  </rule>

  <rule id="100206" level="15" timeframe="60">
    <if_sid>5402</if_sid>
    <if_matched_sid>100205</if_matched_sid>
    <same_user />
    <description>CRÍTICO: User $(user) gained ROOT access via SUDO after multiple failures</description>
    <group>sudo_abuse,</group>
  </rule>

  <rule id="100207" level="10" frequency="8" timeframe="60">
    <if_matched_group>authentication_failures</if_matched_group>
    <same_srcip />
    <description>ALERTA: 8 failed login attempts in 1 minute from IP $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_11.4,</group>
  </rule>

  <rule id="100208" level="14" timeframe="120">
    <if_sid>5715</if_sid>
    <if_matched_sid>100207</if_matched_sid>
    <same_srcip />
    <description>CRÍTICO: Successful login from $(srcip) AFTER a Brute Force attack</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_success,pci_dss_10.2.4,</group>
  </rule>

  <rule id="100308" level="10" frequency="6" timeframe="60">
    <if_matched_sid>100904</if_matched_sid>
    <same_srcip />
    <description>ALERTA: Multiple failed remote login attempts from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>windows_security,pci_dss_8.1.5,</group>
  </rule>

  <rule id="100309" level="14" timeframe="120">
    <if_sid>60106, 18107</if_sid>
    <if_matched_sid>100308</if_matched_sid>
    <regex type="pcre2">Logon Type:\s*(10|3)|"LogonType":\s*"?\s*(10|3)</regex>
    <same_srcip />
    <description>CRÍTICO: Successful RDP connection from $(win.eventdata.ipAddress) AFTER Brute Force attempts</description>
    <mitre>
      <id>T1021.001</id>
    </mitre>
  </rule>

</group>
