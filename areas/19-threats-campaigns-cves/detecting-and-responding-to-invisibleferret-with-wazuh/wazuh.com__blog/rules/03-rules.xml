<group name="invisbleferret,">
  <rule id="100510" level="13">
    <if_sid>554</if_sid>
    <list field="sha256" lookup="match_key">etc/lists/malware-hashes</list>
    <description>A known InvisibleFerret malware hash detected: $(file)</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
  </rule>
</group>
