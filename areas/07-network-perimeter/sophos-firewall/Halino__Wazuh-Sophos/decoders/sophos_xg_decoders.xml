<!--
  Sophos XG / SFOS Firewall - Wazuh Decoders
  Compatible with SFOS v18, v19, v20, v21+
  
  Sophos XG sends key=value formatted syslog messages.
  Fields can be quoted ("value") or unquoted (value).
  
  Place this file in: /var/ossec/etc/decoders/sophos_xg_decoders.xml
  Then restart Wazuh Manager: systemctl restart wazuh-manager
-->

<!-- ============================================================
     PARENT DECODER - Identifies Sophos XG/SFOS log messages
     Matches logs with or without the device="SFW" prefix.
     ============================================================ -->
<decoder name="sophos-xg">
  <prematch type="pcre2">(?:device="SFW"\s+)?date=\d{4}-\d{2}-\d{2}\s+time=\d{2}:\d{2}:\d{2}\s+.*?device_name=</prematch>
  <type>firewall</type>
</decoder>

<!-- ============================================================
     CHILD DECODERS - Extract key=value fields
     Each child decoder extracts a group of related fields.
     All children are evaluated; extracted fields accumulate.
     ============================================================ -->

<!-- Date and Time -->
<decoder name="sophos-xg-datetime">
  <parent>sophos-xg</parent>
  <regex type="pcre2">\bdate=(\d{4}-\d{2}-\d{2})\s+time=(\d{2}:\d{2}:\d{2})</regex>
  <order>sophos_date, sophos_time</order>
</decoder>

<!-- Timezone -->
<decoder name="sophos-xg-timezone">
