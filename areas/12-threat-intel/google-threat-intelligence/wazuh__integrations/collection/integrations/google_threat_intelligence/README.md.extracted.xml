<!-- Blocos de configuração extraídos, sem alterações, de wazuh/integrations:integrations/google_threat_intelligence/README.md @ 38efcaaa3272 -->
<wodle name="command">  
        <disabled>no</disabled>
        <tag>gti-sync</tag>
        <command>/var/ossec/framework/python/bin/python3.10 /var/ossec/wodles/gti/gti-sync.py</command>
        <interval>1h</interval>
        <run_on_start>yes</run_on_start>
        <timeout>300</timeout>
    </wodle>

<integration>
        <name>custom-gti</name>
        <api_key>GTI_API_KEY</api_key> <!-- Replace with your GTI API key -->
        <alert_format>json</alert_format>
        <options>
        {"mitre_attack": true, "realtime": false, "log_level": "INFO", "ip_fields":"src_ip,ip_addresses", "domain_fields":"domain", "url_fields":"", "filehash_fields":"", "vuln_fields":"cveid,cve_id"}
        </options>
    </integration>
