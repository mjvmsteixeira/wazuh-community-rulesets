<!-- Blocos de configuração extraídos, sem alterações, de wazuh/integrations:integrations/misp/README.md @ 38efcaaa3272 -->
<localfile>
  <location>Microsoft-Windows-Sysmon/Operational</location>
  <log_format>eventchannel</log_format>
</localfile>

<integration>
  <name>custom-misp.py</name> <!-- You can remove .py if you copied the bash script -->
  <group>sysmon_event1,sysmon_event3,sysmon_event6,sysmon_event7,sysmon_event_15,sysmon_event_22,syscheck</group>
  <hook_url>https://YOUR_MISP_IP:PORT/</hook_url>
  <api_key>YOUR_API_KEY</api_key>
  <alert_format>json</alert_format>
</integration>
