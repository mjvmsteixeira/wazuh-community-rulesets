<group name="windows">
  <rule id="110003" level="5">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(regsvr32)(?=.*(/s|/u|/i|scrobj))</field>
    <description>Suspicious remote code execution with Regsvr32 on $(win.system.computer)</description>
    <mitre>
      <id>T1218.010</id>
    </mitre>
  </rule>
</group>
